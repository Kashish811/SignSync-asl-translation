# Edit these 3 lines once, then run the numbered scripts in order from this folder (VS Code terminal).
export SS_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"          # this folder
export CSV_DIR="$HOME/Downloads/How2Sign"                                # folder with how2sign_realigned_{train,val,test}.csv
export CKPT="$SS_HOME/hf_unisign/how2sign_pose_only_slt.pth"            # downloaded by 01_download.sh
export VENV="$SS_HOME/.venv"
export TEST_SUBSET=500                                                   # clips for the GNN control runs
export PYTHONNOUSERSITE=1
unset LD_LIBRARY_PATH || true
